rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "4iZybwaOm9hZJhdjRttjmlvnpVu1";
    }

    // Public menu images are readable by the storefront.
    // Only the configured owner can upload/replace or delete menu images.
    match /menu/{allPaths=**} {
      allow read: if true;

      allow create, update: if isOwner()
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');

      allow delete: if isOwner();
    }
  }
}