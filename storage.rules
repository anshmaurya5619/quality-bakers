rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public menu photos can be viewed by customers.
    match /menu/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "PASTE_OWNER_AUTH_UID"
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}