rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn()
        && request.auth.uid == "4iZybwaOm9hZJhdjRttjmlvnpVu1";
    }

    function validCoordinates(location) {
      return location.latitude is number
        && location.longitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude >= -180
        && location.longitude <= 180;
    }

    function validOwnerLocation(location) {
      return location is map
        && location.keys().hasOnly([
          'latitude',
          'longitude',
          'accuracyMeters',
          'capturedAt',
          'active'
        ])
        && validCoordinates(location)
        && location.accuracyMeters is number
        && location.accuracyMeters >= 0
        && location.capturedAt is string
        && location.capturedAt.size() > 0
        && location.capturedAt.size() <= 40
        && location.active is bool;
    }

    function validStatusTransition(oldStatus, newStatus) {
      return oldStatus == newStatus
        || (oldStatus == 'placed' && newStatus in ['confirmed', 'cancelled'])
        || (oldStatus == 'confirmed' && newStatus in ['preparing', 'cancelled'])
        || (oldStatus == 'preparing' && newStatus in ['ready', 'cancelled'])
        || (oldStatus == 'ready' && newStatus in ['completed', 'cancelled']);
    }

    function validCustomerProfile(uid) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phone',
          'createdAt',
          'updatedAt',
          'addresses'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 70
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && (!('createdAt' in request.resource.data)
          || request.resource.data.createdAt is timestamp)
        && (!('updatedAt' in request.resource.data)
          || request.resource.data.updatedAt is timestamp)
        && (!('addresses' in request.resource.data)
          || (request.resource.data.addresses is list
            && request.resource.data.addresses.size() <= 10));
    }

    // Public menu is readable by customers; only the configured owner can publish.
    match /publicMenu/{document} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    // Orders are created only by the trusted Cloudflare Worker.
    // The Worker verifies Firebase ID tokens and recalculates every line against
    // publicMenu/current before writing with its server-side service account.
    match /orders/{orderId} {
      // No browser/customer can submit a forged total or write an order directly.
      allow create: if false;

      // Owner can query all orders; a customer can query only their own UID orders.
      allow get, list: if isOwner()
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      // Only the owner can advance status or update the owner's live GPS.
      allow update: if isOwner()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in [
              'placed',
              'confirmed',
              'preparing',
              'ready',
              'completed',
              'cancelled'
            ]
            && validStatusTransition(
              resource.data.get('status', 'placed'),
              request.resource.data.status
            )
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerLocation', 'trackingUpdatedAt'])
            && validOwnerLocation(request.resource.data.ownerLocation)
            && request.resource.data.trackingUpdatedAt == request.time
            && resource.data.get('status', 'placed') in [
              'confirmed',
              'preparing',
              'ready'
            ]
          )
        );

      allow delete: if isOwner();
    }

    // Signed-in customers can read announcements; only owner can publish/remove.
    match /announcements/{announcementId} {
      allow read: if signedIn();

      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'title',
          'message',
          'createdAt',
          'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isOwner();
    }

    // Customer profile, phone and up to 10 saved addresses are private to that UID.
    match /customers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;

      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && validCustomerProfile(uid);

      allow update: if signedIn()
        && request.auth.uid == uid
        && validCustomerProfile(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name',
            'email',
            'phone',
            'createdAt',
            'updatedAt',
            'addresses'
          ]);

      allow delete: if isOwner();
    }
  }
}