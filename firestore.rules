rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public menu is readable by customers. Only the configured owner UID can write.
    match /publicMenu/{document} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "PASTE_OWNER_AUTH_UID";
    }
  }
}