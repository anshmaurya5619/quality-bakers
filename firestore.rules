rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn() && request.auth.uid == "4iZybwaOm9hZJhdjRttjmlvnpVu1";
    }

    // Publicly readable published menu; only the owner may publish.
    match /publicMenu/{document} {
      allow read: if true;
      allow write: if isOwner();
    }

    // A customer can create an order only for their own authenticated UID.
    // Owner can read every order and update its status from admin.html.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid','customerName','customerEmail','customerPhone',
          'note','deliveryLocation','items','total','status','createdAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 70
        && request.resource.data.deliveryLocation is map
        && request.resource.data.deliveryLocation.mode in ['gps','manual']
        && (request.resource.data.deliveryLocation.mode == 'gps'
          ? request.resource.data.deliveryLocation.latitude is number
            && request.resource.data.deliveryLocation.longitude is number
            && request.resource.data.deliveryLocation.latitude >= -90
            && request.resource.data.deliveryLocation.latitude <= 90
            && request.resource.data.deliveryLocation.longitude >= -180
            && request.resource.data.deliveryLocation.longitude <= 180
          : request.resource.data.deliveryLocation.address is string
            && request.resource.data.deliveryLocation.address.size() >= 5
            && request.resource.data.deliveryLocation.address.size() <= 500)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read: if isOwner()
        || (signedIn() && resource.data.customerUid == request.auth.uid);
      // Owner can update order status or publish their current delivery GPS.
      allow update: if isOwner()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status','updatedAt'])
            && request.resource.data.status in [
              'placed','confirmed','preparing','ready','completed','cancelled'
            ]
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerLocation','trackingUpdatedAt'])
            && request.resource.data.ownerLocation is map
            && request.resource.data.ownerLocation.latitude is number
            && request.resource.data.ownerLocation.longitude is number
            && request.resource.data.ownerLocation.latitude >= -90
            && request.resource.data.ownerLocation.latitude <= 90
            && request.resource.data.ownerLocation.longitude >= -180
            && request.resource.data.ownerLocation.longitude <= 180
          )
        );
      allow delete: if isOwner();
    }

    // Customer can access only their own profile.
    match /customers/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if isOwner();
    }
  }
}