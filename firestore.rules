rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && request.auth.uid == "4iZybwaOm9hZJhdjRttjmlvnpVu1";
    }

    function validCoordinates(location) {
      return location.latitude is number
        && location.longitude is number
        && location.latitude >= -90
        && location.latitude <= 90
        && location.longitude >= -180
        && location.longitude <= 180;
    }

    function validDeliveryLocation(location) {
      return location is map
        && location.keys().hasOnly([
          'mode', 'latitude', 'longitude', 'accuracyMeters', 'capturedAt',
          'address', 'manualAddress'
        ])
        && location.mode in ['gps', 'manual']
        && (
          (location.mode == 'gps'
            && validCoordinates(location)
            && (!('accuracyMeters' in location)
              || (location.accuracyMeters is number
                && location.accuracyMeters >= 0
                && location.accuracyMeters <= 10000)))
          ||
          (location.mode == 'manual'
            && location.address is string
            && location.address.size() >= 8
            && location.address.size() <= 500)
        )
        && (!('capturedAt' in location)
          || (location.capturedAt is string && location.capturedAt.size() <= 40))
        && (!('address' in location)
          || (location.address is string && location.address.size() <= 500))
        && (!('manualAddress' in location)
          || (location.manualAddress is string && location.manualAddress.size() <= 500));
    }

    function validStatusTransition(oldStatus, newStatus) {
      return oldStatus == newStatus
        || (oldStatus == 'placed' && newStatus in ['confirmed', 'cancelled'])
        || (oldStatus == 'confirmed' && newStatus in ['preparing', 'cancelled'])
        || (oldStatus == 'preparing' && newStatus in ['ready', 'cancelled'])
        || (oldStatus == 'ready' && newStatus in ['completed', 'cancelled']);
    }

    function validOwnerLocation(location) {
      return location is map
        && location.keys().hasOnly([
          'latitude', 'longitude', 'accuracyMeters', 'capturedAt', 'active'
        ])
        && validCoordinates(location)
        && location.accuracyMeters is number
        && location.accuracyMeters >= 0
        && location.accuracyMeters <= 10000
        && location.capturedAt is string
        && location.capturedAt.size() > 0
        && location.capturedAt.size() <= 40
        && location.active is bool;
    }

    // Public menu data is readable by everyone; only the verified owner can publish it.
    match /publicMenu/{document} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /orders/{orderId} {
      // Customer can create only an order under their own authenticated account.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'customerEmail', 'customerPhone',
          'note', 'deliveryLocation', 'items', 'total', 'status', 'createdAt'
        ])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 70
        && request.resource.data.customerEmail is string
        && request.resource.data.customerEmail.size() <= 254
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 10
        && request.resource.data.customerPhone.size() <= 20
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && validDeliveryLocation(request.resource.data.deliveryLocation)
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000
        && request.resource.data.status == 'placed'
        && request.resource.data.createdAt == request.time;

      allow read: if isOwner()
        || (signedIn() && resource.data.customerUid == request.auth.uid);

      // Only the owner may change status or publish/stop delivery-location sharing.
      allow update: if isOwner()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
            && request.resource.data.status in [
              'placed', 'confirmed', 'preparing', 'ready', 'completed', 'cancelled'
            ]
            && validStatusTransition(resource.data.status, request.resource.data.status)
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['ownerLocation', 'trackingUpdatedAt'])
            && validOwnerLocation(request.resource.data.ownerLocation)
            && request.resource.data.trackingUpdatedAt == request.time
            && resource.data.status in ['confirmed', 'preparing', 'ready']
          )
        );

      allow delete: if isOwner();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly([
          'title', 'message', 'createdAt', 'createdBy'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 600
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner();
    }

    match /customers/{uid} {
      // A customer may read/write only their own bounded profile document.
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'createdAt', 'updatedAt', 'addresses'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 70
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && (!('addresses' in request.resource.data)
          || (request.resource.data.addresses is list
            && request.resource.data.addresses.size() <= 10));
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'createdAt', 'updatedAt', 'addresses'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 70
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 20
        && (!('addresses' in request.resource.data)
          || (request.resource.data.addresses is list
            && request.resource.data.addresses.size() <= 10))
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['uid', 'name', 'email', 'phone', 'updatedAt', 'addresses']);
      allow delete: if isOwner();
    }
  }
}